{
  "name": "feedmypixel-site",
  "private": true,
  "version": "0.0.1",
  "description": "FeedMyPixel site — brochure + dev blog (SvelteKit static)",
  "author": "Ben Chidgey <ben@feedmypixel.com> (https://feedmypixel.com)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:host": "pnpm dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint . && stylelint \"**/*.{css,svelte}\"",
    "lint:css": "stylelint \"**/*.{css,svelte}\"",
    "lint:css:fix": "stylelint --fix \"**/*.{css,svelte}\"",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "TZ=UTC vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.e2e.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "security-audit": "pnpm audit --audit-level=moderate",
    "prepare": "pnpm setup:husky",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "25.9.3",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-svelte": "3.19.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "mdsvex": "^0.12.7",
    "playwright": "1.61.0",
    "postcss-html": "1.8.1",
    "prettier": "3.8.5",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.13.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-standard": "40.0.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "^8.0.16",
    "vitest": "4.1.9",
    "vitest-browser-svelte": "2.1.1"
  }
}
